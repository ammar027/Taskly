{
  "cli": {
    "version": ">= 3.15.1"
  },
  "build": {
    "development": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": true
      },
      "web": {
        "env": {}
      }
    },
    "development:device": {
      "extends": "development",
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": false
      }
    },
    "preview": {
      "extends": "production",
      "distribution": "internal",
      "ios": { "simulator": true },
      "android": { "buildType": "apk" },
      "web": {
        "env": {}
      }
    },
    "preview:device": {
      "extends": "preview",
      "ios": { "simulator": false }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "web": {
        "env": {}
      }
    },
    "web-preview": {
      "distribution": "internal",
      "web": {
        "env": {}
      }
    },
    "web-production": {
      "web": {
        "env": {}
      }
    }
  },
  "submit": {
    "production": {},
    "web-production": {
      "web": {}
    }
  }
}